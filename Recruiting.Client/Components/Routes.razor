@using Microsoft.AspNetCore.Components.Authorization
@using Recruiting.Client.Components.Layout

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
                <NotAuthorized>
                    <div style="max-width: 440px; margin: 60px auto; background-color: var(--bg-card); border: 1px solid var(--border-main); border-radius: 8px; padding: 32px 24px; text-align: center;">
                        <h3 style="font-size: 18px; font-weight: 800; color: var(--text-primary); margin-bottom: 8px;">Требуется авторизация</h3>
                        <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.5; margin-bottom: 20px;">
                            Для доступа к этой рабочей странице войдите в систему под учетной записью рекрутера.
                        </p>
                        <a href="login" style="display: inline-block; padding: 8px 20px; border-radius: 6px; background-color: var(--hh-red); color: #FFFFFF; font-size: 13px; font-weight: 600; text-decoration: none;">
                            Войти в систему
                        </a>
                    </div>
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(MainLayout)">
                <div style="max-width: 440px; margin: 60px auto; background-color: var(--bg-card); border: 1px solid var(--border-main); border-radius: 8px; padding: 32px 24px; text-align: center;">
                    <h2 style="font-size: 28px; font-weight: 800; color: var(--text-primary); margin-bottom: 6px;">404</h2>
                    <h3 style="font-size: 16px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px;">Страница не найдена</h3>
                    <p style="font-size: 13px; color: var(--text-secondary); margin-bottom: 20px;">
                        Запрашиваемый раздел не существует или был перемещен.
                    </p>
                    <a href="/" style="display: inline-block; padding: 8px 20px; border-radius: 6px; background-color: var(--hh-red); color: #FFFFFF; font-size: 13px; font-weight: 600; text-decoration: none;">
                        На главную
                    </a>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
