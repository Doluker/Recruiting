@using Recruiting.Client.Interfaces
@using Recruiting.Shared.DTOs
@inject IResumeServiceClient ResumeClient
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Загрузка резюме (PDF)</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_uploadedFileDto == null)
        {
            <MudFileUpload T="IBrowserFile" FilesChanged="OnFileSelected" Accept=".pdf">
                <ActivatorContent>
                    <MudPaper Outlined="true" Class="pa-6 d-flex flex-column align-center justify-center gap-2 cursor-pointer" Style="border-style: dashed; border-width: 2px;">
                        <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Large" Color="Color.Secondary" />
                        <MudText Typo="Typo.body1">
                            @(_selectedFile != null ? _selectedFile.Name : "Нажмите или перетащите PDF-файл резюме сюда")
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Default">Максимальный размер: 15 МБ</MudText>
                    </MudPaper>
                </ActivatorContent>
            </MudFileUpload>

            @if (_isUploading)
            {
                <div class="mt-4">
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
                    <MudText Typo="Typo.caption" Align="Align.Center">Загрузка файла в MinIO...</MudText>
                </div>
            }
        }
        else
        {
            <!-- Карточка результата обработки -->
            <MudAlert Severity="@(_uploadResponse?.IsDuplicate == true ? Severity.Warning : Severity.Success)" Class="mb-3">
                @_uploadResponse?.Message
            </MudAlert>

            <MudCard Outlined="true" Class="pa-3 mb-3">
                <MudText Typo="Typo.subtitle2"><b>Файл:</b> @_uploadedFileDto.OriginalFileName</MudText>
                <MudText Typo="Typo.body2">
                    <b>Статус очереди:</b> 
                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(_uploadedFileDto.ParseJobStatusName)">
                        @(_uploadedFileDto.ParseJobStatusName ?? "В обработке")
                    </MudChip>
                </MudText>
            </MudCard>

            @if (!string.IsNullOrEmpty(_uploadedFileDto.ExtractedText))
            {
                <MudText Typo="Typo.subtitle2" Class="mb-1">Извлечённый текст из PDF:</MudText>
                <MudPaper Outlined="true" Class="pa-3" Style="max-height: 250px; overflow-y: auto; background-color: var(--mud-palette-background-grey); font-size: 0.85rem; white-space: pre-wrap;">
                    @_uploadedFileDto.ExtractedText
                </MudPaper>
            }
            else
            {
                <div class="d-flex align-center gap-2 mt-3">
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                    <MudText Typo="Typo.body2">Воркер извлекает текст из PDF... (нажмите «Обновить статус»)</MudText>
                </div>
            }
        }
    </DialogContent>
    <DialogActions>
        @if (_uploadedFileDto == null)
        {
            <MudButton OnClick="Cancel">Отмена</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_selectedFile == null || _isUploading)" OnClick="UploadAsync">
                Загрузить
            </MudButton>
        }
        else
        {
            <MudButton StartIcon="@Icons.Material.Filled.Refresh" Color="Color.Secondary" OnClick="RefreshStatusAsync">
                Обновить статус
            </MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Cancel">
                Закрыть
            </MudButton>
        }
    </DialogActions>
</MudDialog>
