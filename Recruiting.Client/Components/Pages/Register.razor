@page "/register"
@rendermode InteractiveWebAssembly

<PageTitle>Регистрация — RecruitFlow</PageTitle>

<div class="auth-page-wrap">
    <div class="auth-card register-card">
        <div class="auth-card-top">
            <a href="/" class="back-nav-link">
                <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
                <span>На главную</span>
            </a>
        </div>

        <div class="auth-brand-block">
            <img src="images/logo.png" alt="RecruitFlow" class="auth-brand-logo" />
            <h1 class="auth-title">Создание аккаунта</h1>
            <p class="auth-sub">Регистрация в сервисе автоматизированного подбора персонала</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert-error-box">
                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small" />
                <span>@errorMessage</span>
            </div>
        }

        <EditForm Model="registerModel" OnValidSubmit="HandleRegister">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label class="form-label" for="reg-username">Имя пользователя (Логин)</label>
                <div class="input-container">
                    <MudIcon Icon="@Icons.Material.Outlined.Person" Size="Size.Small" Class="input-icon" />
                    <input id="reg-username" type="text" class="form-field" @bind="registerModel.UserName" placeholder="elena_recruiter" autocomplete="username" />
                </div>
                <ValidationMessage For="() => registerModel.UserName" class="form-error-msg" />
            </div>

            <div class="form-group">
                <label class="form-label" for="reg-email">Рабочий Email</label>
                <div class="input-container">
                    <MudIcon Icon="@Icons.Material.Outlined.Email" Size="Size.Small" Class="input-icon" />
                    <input id="reg-email" type="email" class="form-field" @bind="registerModel.Email" placeholder="elena@company.ru" autocomplete="email" />
                </div>
                <ValidationMessage For="() => registerModel.Email" class="form-error-msg" />
            </div>

            <div class="form-row-dual">
                <div class="form-group flex-1">
                    <label class="form-label" for="reg-pass">Пароль</label>
                    <div class="input-container">
                        <MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Small" Class="input-icon" />
                        <input id="reg-pass" type="password" class="form-field" @bind="registerModel.Password" placeholder="••••••••" autocomplete="new-password" />
                    </div>
                    <ValidationMessage For="() => registerModel.Password" class="form-error-msg" />
                </div>

                <div class="form-group flex-1">
                    <label class="form-label" for="reg-confirm">Повтор пароля</label>
                    <div class="input-container">
                        <MudIcon Icon="@Icons.Material.Outlined.LockReset" Size="Size.Small" Class="input-icon" />
                        <input id="reg-confirm" type="password" class="form-field" @bind="registerModel.ConfirmPassword" placeholder="••••••••" autocomplete="new-password" />
                    </div>
                    <ValidationMessage For="() => registerModel.ConfirmPassword" class="form-error-msg" />
                </div>
            </div>

            <button type="submit" class="btn-submit-action" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="btn-spinner"></span>
                    <span>Создание профиля...</span>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Small" />
                    <span>Зарегистрироваться</span>
                }
            </button>
        </EditForm>

        <div class="auth-footer">
            <span>Уже есть учетная запись? </span>
            <a href="login" class="link-highlight">Войти в аккаунт</a>
        </div>
    </div>
</div>
